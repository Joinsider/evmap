# Copy to deploy/.env and replace every placeholder before deploying.
# Compose reads the .env sitting next to the compose file it was given.

# Image to deploy. Pin to a released version for reproducible rollouts.
EVMAP_IMAGE=ghcr.io/joinsider/evmap:latest

# Database password. Required — the stack refuses to start without it.
POSTGRES_PASSWORD=change-me

# Signing key for the API's own bearer tokens. Long and random, e.g. `openssl rand -base64 48`.
# Rotating it invalidates every issued access token.
JWT_SECRET=change-me

# Apple Sign in client ID (the iOS bundle/service ID). Empty disables the audience check.
APPLE_CLIENT_ID=de.joinside.EVMap

# Where the API listens on the host. Loopback by default — front it with a TLS reverse proxy.
API_BIND=127.0.0.1
API_PORT=8080

# Open Charge Map API key from https://openchargemap.org (my profile -> my apps).
# Empty means German BNetzA data only: the OCM adapter logs a warning and skips itself.
OCM_API_KEY=
OCM_COUNTRY_CODES=DE,AT,CH,NL,BE,LU,FR,IT,DK,PL,CZ

# Pin a Bundesnetzagentur CSV edition; empty discovers the current one each run.
BNETZA_CSV_URL=

# `ecs` (default), `gelf`, `logstash`, or empty for plain text.
LOG_FORMAT=ecs
LOG_LEVEL_APP=INFO
LOG_LEVEL_ROOT=INFO

# /actuator/health reports DOWN when the newest successful sync run is older than this.
SYNC_MAX_AGE=PT48H
