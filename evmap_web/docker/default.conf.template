# Rendered by the nginx image's entrypoint (envsubst on the variables that are set, API_UPSTREAM).

# Paths outside the two locale builds (/, /auth/callback/…, /admin) are sent to the visitor's
# language. The provider redirect URIs are registered without a locale, so this is also what turns
# /auth/callback/google?code=… into /de/auth/callback/google?code=…, query intact.
map $http_accept_language $evmap_locale {
    default de;
    "~^en" en;
}

# Access log without full IP addresses (ADR 0024): the visitor's address is the last X-Forwarded-For entry, the
# one the reverse proxy appended (remote_addr is the proxy; earlier entries come from the client and prove nothing). IPv4 loses its last octet, IPv6 keeps its /48 prefix (or less when
# written compressed), anything else is logged as "-". The privacy policy promises exactly this.
map $http_x_forwarded_for $evmap_client {
    "" $remote_addr;
    "~(?<evmap_last>[^,\s]+)\s*$" $evmap_last;
}
map $evmap_client $evmap_client_anon {
    "~^(?<evmap_v4>\d+\.\d+\.\d+)\.\d+$" $evmap_v4.0;
    "~^(?<evmap_v6>[0-9a-fA-F]{1,4}:[0-9a-fA-F]{1,4}:[0-9a-fA-F]{1,4}):" $evmap_v6::;
    "~^(?<evmap_v6s>[0-9a-fA-F]{1,4}(:[0-9a-fA-F]{1,4})?)::" $evmap_v6s::;
    default -;
}
log_format evmap_anon '$evmap_client_anon [$time_local] "$request" $status $body_bytes_sent $request_time "$http_user_agent"';

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    access_log /var/log/nginx/access.log evmap_anon;
    # Relative Location headers: behind the TLS reverse proxy nginx does not know the public host and port.
    absolute_redirect off;

    # The access token is only ever in memory and in Authorization headers, so the logged request
    # line carries no credential. It can carry a single-use authorization code on the callback route.
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    # MapKit JS (ADR 0023): the script and its libraries come from Apple's CDN, it renders with WebAssembly, workers
    # and blob URLs, and fetches tiles and search results from *.apple-mapkit.com — Apple's documented CSP, nothing more.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.apple-mapkit.com 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.apple-mapkit.com; connect-src 'self' blob: https://*.apple-mapkit.com; worker-src 'self' blob: https://*.apple-mapkit.com; frame-src https://*.apple-mapkit.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    # Resolved per request through the container's DNS, so the web container starts (and keeps
    # working) regardless of whether the API is up yet or has been recreated with a new address.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    location /api/ {
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-Id $request_id;
    }

    # Lets the iOS app receive the sign-in callback on this domain (associated domain, ADR 0018).
    # Written at container start from APPLE_TEAM_ID; absent (404) without it.
    location = /.well-known/apple-app-site-association {
        default_type application/json;
        alias /tmp/evmap/apple-app-site-association;
    }

    # The share link of a route (ADR 0017) opens the app through the associated domain above. Where the app is
    # not installed it arrives here; the web client shows no routes before phase 8, so this is a plain notice.
    location = /route {
        default_type text/html;
        alias /usr/share/nginx/route-notice.html;
    }

    # Name, address and contact of the operator for the Impressum and the privacy policy (ADR 0024), written at
    # container start from OPERATOR_*; absent (404) without them. Revalidated, so an address change shows at once.
    location = /site-operator.json {
        default_type application/json;
        alias /tmp/evmap/site-operator.json;
        expires -1;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location ~ ^/(de|en)/ {
        try_files $uri $uri/ /$1/index.html;
        # index.html must be revalidated so a release is picked up; hashed bundles can be cached forever.
        location ~ \.(js|css|woff2?|ico|png|svg)$ {
            expires 1y;
            add_header Cache-Control "public, immutable" always;
            # add_header here replaces the server-level ones, so the one that matters for scripts is repeated.
            add_header X-Content-Type-Options nosniff always;
        }
    }

    location = /favicon.ico {
        try_files /de/favicon.ico =404;
    }

    location / {
        return 302 /$evmap_locale$request_uri;
    }
}
