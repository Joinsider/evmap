# Copy this file to .env before running Docker Compose.
# Never commit the resulting .env file.

# Used by PostgreSQL and the API database connection.
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Used to sign EVMap access tokens. Generate a long, random value (at least 32 bytes).
JWT_SECRET=replace-with-a-long-random-access-token-signing-secret

# Sign in with Apple client / bundle ID. Leave empty only for local development without Apple login.
APPLE_CLIENT_ID=

# Logging. Containers default to structured ECS JSON on stdout; set LOG_FORMAT= (empty) for plain text,
# or gelf/logstash if your collector expects those. LOG_LEVEL_APP tunes de.joinside.evmap_service only.
LOG_FORMAT=ecs
LOG_LEVEL_APP=INFO
LOG_LEVEL_ROOT=INFO
OCM_API_KEY=
OCM_COUNTRY_CODES=DE,AT,CH,NL,BE,LU,FR,IT,DK,PL,CZ
BNETZA_CSV_URL=
SYNC_BATCH_SIZE=1000
